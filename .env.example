# ============================================================
#  PadelClub — Environment Variables
#  1. Copy this file to .env.local
#  2. Fill in your values from the Supabase dashboard
#  3. Never commit .env.local to git
# ============================================================

# Supabase — Settings → API in your project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key — only used server-side, never exposed to browser
# Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App URL — used for auth redirects
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — Developers → API keys / Webhooks in your Stripe dashboard
# Required for checkout, credit packs, and split payments to work at runtime.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

# Cron secret — any random string, set the same value in Vercel's project
# env vars. Vercel automatically sends it as the Authorization header on
# scheduled cron requests (see vercel.json); this is how /api/cron/* routes
# reject requests that aren't the real cron trigger.
CRON_SECRET=your_random_secret_here

# Web push (VAPID) — generate a key pair once with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose to the browser (NEXT_PUBLIC_); the
# private key must stay server-only. VAPID_SUBJECT is a mailto: or https:
# URL identifying the site owner, per the Web Push spec.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com
